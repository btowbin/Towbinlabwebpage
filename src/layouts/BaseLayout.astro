---
import '../styles/global.css';
import '../styles/media-preservation.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Towbin Lab', description = 'Organismal Systems Biology Lab at the University of Bern' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Towbin Lab</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
