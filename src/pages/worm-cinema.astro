---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/worm-cinema.css';
import cinemaUnits from '../data/worm-cinema.json';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const splitScientificName = (text) => text.split(/(C\. elegans)/g);
---
<BaseLayout title="Worm Cinema">
  <section class="page-intro shell narrow"><h1>Worm cinema</h1></section>
  <section class="shell cinema-list">
    {cinemaUnits.map(({ movie, title, legend }) => (
      <article class="cinema-unit">
        <h2>{splitScientificName(title).map(part => part === 'C. elegans' ? <em>{part}</em> : part)}</h2>
        {movie.endsWith('.mp4') ? (
          <video controls loop muted playsinline preload="metadata">
            <source src={`${base}images/worm-cinema/${movie}`} type="video/mp4" />
          </video>
        ) : (
          <img src={`${base}images/worm-cinema/${movie}`} alt="" />
        )}
        <p>{splitScientificName(legend).map(part => part === 'C. elegans' ? <em>{part}</em> : part)}</p>
      </article>
    ))}
  </section>
</BaseLayout>
