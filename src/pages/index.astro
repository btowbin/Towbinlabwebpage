---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
const links = [['/research','Research'],['/outreach','Outreach'],['/people','People'],['/worm-cinema','Worm Cinema'],['/publications','Publications'],['/contact','Contact']];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home">
  <section class="home shell">
    <div class="home-top"><h1>Organismal Systems Biology Lab</h1><img src={`${base}images/home-worm.png`} alt="Computationally straightened C. elegans" /></div>
    <div class="home-links">{links.map(([href, label]) => <a href={`${base}${href.slice(1)}`}>{label}</a>)}</div>
  </section>
</BaseLayout>
