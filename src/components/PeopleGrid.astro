---
const { people } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const groups = [...new Set(people.filter(p => p.active).sort((a,b) => a.order - b.order).map(p => p.category))];
---
{groups.map(group => (
  <section class="people-section">
    <h2>{group}</h2>
    <div class="people-grid">
      {people
        .filter(p => p.active && p.category === group)
        .sort((a,b) => a.order-b.order)
        .map(person => (
          <article class="person-card">
            <img src={`${base}${person.photo.slice(1)}`} alt={`Portrait of ${person.name}`} loading="lazy" />
            <div>
              <h3>{person.name}</h3>
              <p class="eyebrow">{person.role}</p>
              {person.description.map(text => (
                <p>{text.split(/(\*[^*]+\*)/g).map(part =>
                  part.startsWith('*') && part.endsWith('*')
                    ? <em>{part.slice(1, -1)}</em>
                    : part
                )}</p>
              ))}
              {person.links?.length && (
                <p class="inline-links">
                  {person.links.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}
                </p>
              )}
            </div>
          </article>
        ))}
    </div>
  </section>
))}
